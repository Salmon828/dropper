<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/main-menu.uss?fileID=7433441132597879392&amp;guid=9ed1fd8fc508cae4fbd316b26ef55c78&amp;type=3#main-menu" />
    <ui:VisualElement name="Panel" class="panel" style="flex-grow: 1;">
        <ui:VisualElement name="main" class="menu" style="flex-grow: 1; width: 512px; height: auto; min-height: auto; max-height: 537px; display: flex;">
            <ui:Button text="Play" name="PlayButton" class="unity-button" />
            <ui:Button text="Options" name="OptionsButton" class="unity-button" />
            <ui:Button text="Quit" name="QuitButton" class="unity-button" />
        </ui:VisualElement>
        <ui:VisualElement name="color" enabled="true" class="menu" style="flex-grow: 1; width: 878px; justify-content: center; align-items: stretch; display: none; visibility: visible;">
            <ui:SliderInt label="Red" value="255" high-value="255" name="red" class="slider" />
            <ui:SliderInt label="Green" value="255" high-value="255" name="green" class="slider" />
            <ui:SliderInt label="Blue" value="255" high-value="255" name="blue" class="slider" style="position: relative;" />
            <ui:VisualElement name="colorDisp" style="flex-grow: 1; flex-shrink: 0; flex-direction: column; width: 77px; height: auto; max-height: 56px; min-width: auto; max-width: none; justify-content: flex-end; align-self: center; top: 20%; background-color: rgb(255, 255, 255);" />
            <ui:Label text="255,255,255" name="rgbValues" style="color: rgb(255, 255, 255); font-size: 22px; -unity-text-align: upper-center; top: -48px;" />
            <ui:Label text="Current Color" name="current" style="color: rgb(255, 255, 255); -unity-text-align: upper-center; top: 5%; font-size: 23px;" />
            <ui:Button text="Back" name="colorBack" class="unity-button" style="width: 169px; max-height: 42px; top: 270px; font-size: 29px;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
