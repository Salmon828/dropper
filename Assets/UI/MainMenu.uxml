<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/main-menu.uss?fileID=7433441132597879392&amp;guid=9ed1fd8fc508cae4fbd316b26ef55c78&amp;type=3#main-menu"/>
    <ui:VisualElement name="Panel" class="panel" style="flex-grow: 1;">
        <ui:Image name="Title" class="letter" style="background-image: url(&quot;project://database/Assets/UI/droppertitle.png?fileID=2800000&amp;guid=bc557cba71c2fa64c88f6448380effbd&amp;type=3#droppertitle&quot;); height: 286px; width: 1316px; margin-bottom: 81px; display: flex;"/>
        <ui:VisualElement name="main" class="menu" style="flex-grow: 1; width: 512px; height: auto; min-height: auto; max-height: 537px; display: flex;">
            <ui:Button text="PLAY" name="PlayButton" class="unity-button"/>
            <ui:Button text="OPTIONS" name="OptionsButton" class="unity-button"/>
            <ui:Button text="QUIT" name="QuitButton" class="unity-button"/>
        </ui:VisualElement>
        <ui:VisualElement name="gamemodes" class="menu" style="flex-direction: column; bottom: 24%; display: none; width: 535px;">
            <ui:Button text="LOCAL PLAY" name="LocalButton" class="unity-button gmode-button"/>
            <ui:Button text="ONLINE" name="OnlineButton" class="gmode-button"/>
            <ui:Button text="VS CPU" name="VsCPUButton" class="gmode-button"/>
            <ui:Button text="Back" name="ModeBack" class="gmode-button"/>
        </ui:VisualElement>
        <ui:VisualElement name="online" style="display: none; align-items: center;">
            <ui:ListView name="LobbyList" virtualization-method="DynamicHeight" show-border="true" style="width: 1384px; height: 561px; display: flex;"/>
            <ui:Label text="Players: 1/2" name="Playercount" class="gmode-button" style="color: rgb(255, 255, 255); visibility: visible; position: absolute; left: -19%; bottom: 0; display: none;"/>
            <ui:Label name="StatusText" style="display: none; color: rgb(255, 255, 255); font-size: 26px; -unity-text-align: middle-center; margin-top: 10px;"/>
            <ui:VisualElement name="onlinecolumns" style="flex-grow: 0; flex-direction: row; align-items: auto; justify-content: flex-start; align-content: flex-start;">
                <ui:VisualElement name="onlinecol1" style="flex-grow: 1; align-items: stretch;">
                    <ui:Button text="Host" name="HostButton" class="gmode-button"/>
                    <ui:Button text="Quick Join" name="QJButton" class="gmode-button"/>
                </ui:VisualElement>
                <ui:VisualElement name="onlinecol2" style="flex-grow: 1; width: 430px;">
                    <ui:Button text="Refresh" name="RefreshButton" class="gmode-button"/>
                    <ui:Button text="Back" name="OnlineBack" class="gmode-button"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="color" enabled="true" class="menu" style="flex-grow: 1; width: 1500px; justify-content: center; align-items: center; display: none; visibility: visible;">
            <ui:VisualElement name="colorColumns" style="flex-direction: row; align-self: stretch;">
                <ui:VisualElement name="colorP1" style="flex-grow: 1; flex-basis: 0; margin-left: 20px; margin-right: 20px;">
                    <ui:Label text="PLAYER 1" name="colorTitle1" style="color: rgb(255, 255, 255); font-size: 30px; -unity-text-align: upper-center; margin-bottom: 10px;"/>
                    <ui:SliderInt label="Red" value="255" high-value="255" name="red" class="slider"/>
                    <ui:SliderInt label="Green" value="255" high-value="255" name="green" class="slider"/>
                    <ui:SliderInt label="Blue" value="255" high-value="255" name="blue" class="slider"/>
                    <ui:VisualElement name="colorDisp" style="width: 77px; height: 56px; align-self: center; margin-top: 20px; background-color: rgb(255, 255, 255);"/>
                    <ui:Label text="255, 255, 255" name="rgbValues" style="color: rgb(255, 255, 255); font-size: 22px; -unity-text-align: upper-center; margin-top: 8px;"/>
                </ui:VisualElement>
                <ui:VisualElement name="colorP2" style="flex-grow: 1; flex-basis: 0; margin-left: 20px; margin-right: 20px;">
                    <ui:Label text="PLAYER 2" name="colorTitle2" style="color: rgb(255, 255, 255); font-size: 30px; -unity-text-align: upper-center; margin-bottom: 10px;"/>
                    <ui:SliderInt label="Red" value="255" high-value="255" name="red2" class="slider"/>
                    <ui:SliderInt label="Green" value="0" high-value="255" name="green2" class="slider"/>
                    <ui:SliderInt label="Blue" value="0" high-value="255" name="blue2" class="slider"/>
                    <ui:VisualElement name="colorDisp2" style="width: 77px; height: 56px; align-self: center; margin-top: 20px; background-color: rgb(255, 0, 0);"/>
                    <ui:Label text="255, 0, 0" name="rgbValues2" style="color: rgb(255, 255, 255); font-size: 22px; -unity-text-align: upper-center; margin-top: 8px;"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Button text="Back" name="colorBack" class="unity-button" style="width: 169px; max-height: 60px; flex-grow: 0; font-size: 29px; height: 44px;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
